// lockme configuration (KDL 2.0). All values shown here are the built-in
// defaults; uncomment or edit lines to override. CLI flags always win over
// values set here.

// At-rest screen color (pure black).
init-color "0x000000"

// Color shown after a failed authentication attempt (deep crimson).
fail-color "0x8B0000"

// Palette cycled through on each keypress while typing the password.
// Default order: Father (Tyrian indigo/violet), Son (royal blue),
// Spirit (life green).
inputs {
    color "0x4B0082"
    color "0x003366"
    color "0x006400"
}

// Diagnostic verbosity: error | warning | info | debug
log-level "error"

// Detach to the background after locking succeeds.
fork-on-lock #false

// Ignore an empty password buffer when Enter is pressed (prevents
// accidentally submitting nothing to PAM).
ignore-empty-password #true

// Start with a blank screen instead of Matrix rain.
blank #false

// Disable GPU rendering and use the CPU renderer instead.
// Reduces EGL/driver attack surface; useful on hardened setups.
no-gpu #false

// Blank the screen after this many seconds of inactivity (0 = disabled).
// The screen wakes back to matrix on the next keypress.
idle-timeout 0

// Matrix rain frame interval in milliseconds (higher is slower).
matrix-frame-ms 40

// Matrix rain timing. These use the same normalized shape as the GPU shader:
// fall speed controls vertical motion, cycle speed controls glyph changes,
// raindrop length controls trail spacing, and brightness decay controls fade.
matrix-cell-scale "auto"
matrix-fall-speed 0.3
matrix-cycle-speed 0.03
matrix-raindrop-length 0.75
matrix-brightness-decay 1.0
