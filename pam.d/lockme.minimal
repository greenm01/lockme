# Minimal, auditable auth chain for lockme.
#
# This is an OPT-IN alternative to the default pam.d/lockme, which uses
# `auth include system-auth` and therefore inherits whatever the
# distribution's system-auth chain pulls in (pam_systemd_home,
# pam_gnome_keyring, fingerprint readers, smartcards, etc.).
#
# This file replaces that inheritance with an explicit, distribution-
# independent chain containing only password verification (pam_unix) and
# bruteforce backoff (pam_faillock). It does NOT support:
#   - systemd-homed (pam_systemd_home)
#   - GNOME Keyring / KWallet auto-unlock
#   - fingerprint readers (pam_fprintd)
#   - smartcards / yubikeys (pam_pkcs11, pam_u2f)
#   - any other auxiliary auth method configured in system-auth
#
# Faillock tunables (deny=, unlock_time=, etc.) are inherited from
# /etc/security/faillock.conf rather than hardcoded here.
#
# To install:
#   sudo install -m 0644 pam.d/lockme.minimal /etc/pam.d/lockme

auth        required      pam_faillock.so preauth
auth        required      pam_unix.so     nullok
auth        [default=die] pam_faillock.so authfail
auth        sufficient    pam_faillock.so authsucc

account     required      pam_unix.so
